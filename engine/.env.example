# Supabase (banco, login e fotos). A chave é a PÚBLICA (publishable): vai
# para o navegador de propósito, e quem protege os dados é a RLS do banco.
# Painel do Supabase > Project Settings > API Keys.
VITE_SUPABASE_URL=https://evaankeqxykcktxvesbf.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend Java (engine-api). Só o cliente avulso `services/api.js` usa; o app
# fala direto com o Supabase.
VITE_API_URL=http://localhost:8080/api

# Google AdSense (anúncios). Enquanto estas variáveis ficarem vazias, o
# <AdSlot /> mostra um "house ad" (convite ao Premium) em vez de anúncio real.
# Preencha depois que a conta do AdSense for aprovada.
#   VITE_ADSENSE_CLIENT: seu publisher id, no formato ca-pub-0000000000000000
#   VITE_ADSENSE_SLOT_DEFAULT: id numérico da unidade de anúncio criada no painel
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_DEFAULT=

# Observabilidade. Mesma regra do AdSense: vazio = desligado, nada é carregado
# e nada é enviado. Preencha quando criar as contas (as duas têm plano free).
#   VITE_SENTRY_DSN: erros e crashes. Painel > Settings > Client Keys (DSN)
#   VITE_POSTHOG_KEY: analytics de produto. Começa com "phc_"
#   VITE_POSTHOG_HOST: só mude se a sua organização for na região da UE
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# Variáveis de SERVIDOR (Netlify Functions). NÃO levam prefixo VITE_ de
# propósito: tudo que começa com VITE_ vai parar no bundle do navegador, e
# estas são chaves secretas. Configure só no painel do Netlify, em
# Site settings > Environment variables. Nunca no .env do repositório.
#
#   SUPABASE_URL                   https://evaankeqxykcktxvesbf.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY      Chave service_role (ignora a RLS: só o
#                                  servidor, para gravar o plano pago)
#   MERCADOPAGO_ACCESS_TOKEN       Access token de produção (LatAm)
#   MERCADOPAGO_WEBHOOK_SECRET     Segredo da notificação, no painel do MP
#   STRIPE_SECRET_KEY              Chave secreta (EUA e Europa)
#   STRIPE_PRICE_ID                Id do preço recorrente do plano Premium
#   STRIPE_WEBHOOK_SECRET          Signing secret do endpoint de webhook
# ---------------------------------------------------------------------------
