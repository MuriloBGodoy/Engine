rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // `.get("email", "")` e não `.email`: conta sem e-mail no token (login
    // social sem e-mail verificado, e todo contexto de teste que não passa
    // claims) fazia esta função ESTOURAR — "Property email is undefined on
    // object" — em vez de devolver false. O Firestore trata erro como negação,
    // então o efeito parecia certo; mas negação por acidente não é regra, é
    // sorte, e quando `isServiceAdmin()` é o primeiro ramo de um `||` o erro
    // vira ruído em cima de toda avaliação. Achado pelos testes de clube.
    function isServiceAdmin() {
      return signedIn() && request.auth.token.get("email", "") in [
        "muxdtuber@gmail.com"
      ];
    }

    // Cargo dentro do clube. Um clube é uma crew: fundador, capitão e membro.
    // Quem decide o que cada um pode é SEMPRE esta regra, nunca a tela — o
    // painel do capitão some do React, mas o `fetch` do console não some.
    //
    // As três funções fazem no máximo UM `get` cada, e todas passam por
    // `exists()` antes de ler `.data`: `get()` num documento que não existe
    // devolve null, e ler `.role` de null é erro de avaliação — que o
    // Firestore trata como negação, mas negação por acidente não é regra, é
    // sorte. Com o `exists()` na frente, quem não é membro cai no `false` de
    // propósito.
    function isClubMember(clubId) {
      return signedIn()
        && exists(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid));
    }

    function clubRole(clubId) {
      return get(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid)).data.role;
    }

    function isClubStaff(clubId) {
      return isClubMember(clubId) && clubRole(clubId) in ["founder", "captain"];
    }

    function isClubFounder(clubId) {
      return isClubMember(clubId) && clubRole(clubId) == "founder";
    }

    // Carimbo de clube em conteúdo de outra feature (evento, post). Conteúdo
    // sem clube segue a regra antiga — o campo é opcional de propósito, para
    // não quebrar os eventos e posts que já existem.
    //
    // Sem operador ternário aqui de propósito, e não é estilo: com
    // `exigeCargo ? isClubStaff(...) : isClubMember(...)` o emulador do
    // Firestore MORRE — `IllegalStateException: ternary operator predicate is
    // always boolean`, e o cliente fica em retry infinito com
    // "UNKNOWN: Application error processing RPC" em vez de receber um erro.
    // Descoberto em 24/09/2026 rodando os testes desta feature. A forma com
    // `&&`/`||` é equivalente e não acorda o defeito.
    function clubStampAllowed(clubId, exigeCargo) {
      return clubId == ""
        || (exigeCargo && isClubStaff(clubId))
        || (!exigeCargo && isClubMember(clubId));
    }

    function clubStampUnchanged() {
      return request.resource.data.get("clubId", "") == resource.data.get("clubId", "");
    }

    // O doc do usuário guarda o plano da assinatura. Faltava regra aqui: sem
    // ela o Firestore negava a leitura por padrão, o useIsPremium caía no erro
    // e tratava todo mundo como gratuito — premium nunca ligaria, mesmo com o
    // pagamento confirmado.
    //
    // `plan` é escrito SÓ pelo webhook, via Admin SDK, que ignora estas regras.
    // Nenhum caminho do cliente pode escrever aqui: senão bastava abrir o
    // console do navegador pra virar premium de graça.
    match /users/{userId} {
      allow read: if isOwner(userId) || isServiceAdmin();
      allow write: if false;
    }

    match /users/{userId}/cars/{carId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/private/{docId} {
      allow read, write: if isOwner(userId);
    }

    // Conquistas: um documento por marco, com o id sendo o próprio marco.
    //
    // Quem detecta o cruzamento é o cliente de quem praticou a ação — o Firebase
    // está no plano Spark, então não há Cloud Function pra fazer isso do lado do
    // servidor. Ou seja: é escrita no perfil de OUTRA pessoa, e a regra é a
    // única defesa. Ela faz três coisas:
    //
    //   1. `create` apenas, nunca `update` — conquista não muda, ela acontece.
    //      Como o Firestore nega `create` em documento existente, dois cliques
    //      simultâneos cruzando o mesmo marco não duplicam: o segundo falha
    //      sozinho, sem transação e sem notificação repetida.
    //   2. lista FECHADA de ids. Sem isso, campo livre viraria selo inventado.
    //   3. `unlockedAt` é a única coisa no corpo, então não dá pra pendurar
    //      dado arbitrário no perfil alheio usando a conquista como carona.
    //
    // Apagar é do dono: conquista precisa ser revogável sem reconstruir nada,
    // porque ela não guarda estado incremental — só "aconteceu". É a rede de
    // segurança contra fraude descoberta depois, e sai de graça neste desenho.
    match /users/{userId}/achievements/{achievementId} {
      function marcoValido() {
        return achievementId in [
          "first_goal",
          "first_conquest",
          "owned_car",
          "followers_1000",
          "likes_1000",
          "likes_10000",
          "likes_50000",
          "likes_100000",
          "likes_500000",
          "likes_1000000"
        ];
      }

      // Conquista é vitrine: aparece no perfil público de quem visita.
      allow read: if true;

      allow create: if signedIn()
        && marcoValido()
        && request.resource.data.keys().hasOnly(["unlockedAt"]);

      allow update: if false;
      allow delete: if isOwner(userId) || isServiceAdmin();
    }

    match /users/{userId}/notifications/{notificationId} {
      // Aviso e escrita alheia por natureza: quem notifica e quem agiu, do
      // cliente dele, porque o plano Spark nao tem Cloud Function pra fazer
      // isso do lado do servidor. `signedIn()` sozinho deixava qualquer conta
      // escrever qualquer coisa na caixa de qualquer pessoa: texto livre,
      // remetente forjado, ja marcado como lido, com data no futuro pra ficar
      // grudado no topo. Todos os sete pontos que notificam no app passam pelo
      // mesmo `notifyUser`, entao a regra pode exigir o formato que ele produz.
      function notificacaoHonesta() {
        return request.resource.data.type in [
                 "follow", "like", "comment", "rating", "achievement",
                 "message",
                 "service_approved", "service_changes_requested", "service_rejected"
               ]
               // Nao da pra assinar em nome de outro.
               && request.resource.data.actorId == request.auth.uid
               // Nem entregar num endereco e dizer que era de outro.
               && request.resource.data.recipientId == userId
               // Nasce por ler; ninguem chega lido nem some da contagem.
               && request.resource.data.read == false
               // Sem data escolhida a dedo: futuro fixaria o aviso no topo.
               && request.resource.data.createdAt == request.time
               && (!("text" in request.resource.data)
                   || request.resource.data.text.size() < 500);
      }

      allow read, update, delete: if isOwner(userId);
      allow create: if signedIn() && notificacaoHonesta();
    }

    match /usernames/{username} {
      // `get` público: o cadastro precisa saber se o nome existe ANTES de
      // criar a conta (senão nasce conta órfã que prende o e-mail). O doc só
      // tem nome → id, e o id já é público pelo publicProfiles. `list` segue
      // fechado: ninguém enumera a base de usuários por aqui.
      allow get: if true;
      allow list: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      // Excluir a conta libera o @. Sem isto o nome ficava preso para sempre
      // a um uid que não existe mais.
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /publicProfiles/{userId} {
      // Perfil público é vitrine: quem chega por link compartilhado precisa
      // ver de quem é a garagem antes de decidir criar conta.
      allow read: if true;
      allow create, update: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(userId);

      // Seguidores: cada pessoa só cria/remove o próprio doc de seguidor.
      // `update` entra junto porque setDoc num doc que já existe (re-seguir
      // sem ter deixado de seguir) é update, não create.
      match /followers/{followerId} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn() && request.auth.uid == followerId;
      }

      // Seguindo: espelho do doc de seguidor, guardado na conta de quem segue.
      // Qualquer pessoa logada lê (a aba "Seguindo" é pública), mas só o dono
      // da lista escreve nela.
      match /following/{targetUserId} {
        allow read: if signedIn();
        allow create, update, delete: if isOwner(userId);
      }
    }

    match /communityGoals/{goalId} {
      function isGoalOwner() {
        return signedIn() && resource.data.ownerId == request.auth.uid;
      }

      // Curtir, avaliar e comentar são updates no documento de OUTRA pessoa,
      // então update não pode ser negado pra quem não é dono — mas também não
      // pode ser liberado inteiro, senão qualquer um logado reescreve titulo,
      // foto, valores ou legenda de qualquer publicação. Visitante só encosta
      // nestes campos, e em likesBy/ratingsBy só na própria chave.
      // O `.get(campo, {})` cobre documento antigo que nem tem o mapa.
      //
      // `likesCount` é número de VITRINE, mantido por quem curte. Como é escrita
      // no documento alheio, a regra prende o passo em 1 pra cima ou 1 pra baixo
      // — sem isso um cliente manda increment(9999) numa curtida só. Quem manda
      // na verdade é a subcoleção `likes` abaixo, que ninguém consegue forjar;
      // por isso o marco de conquista se conta lá, não neste número.
      //
      // `likesBy` continua na lista só durante a transição: o mapa está sendo
      // esvaziado e o código novo não escreve nele. Sai numa limpeza depois de a
      // migração estar confirmada — tirar agora quebraria qualquer build antigo
      // que ainda esteja no ar.
      function onlyInteraction() {
        let antes = resource.data.get("likesCount", 0);
        let depois = request.resource.data.get("likesCount", 0);
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["likesBy", "likesCount", "ratingsBy", "comments", "updatedAt"])
          && depois >= antes - 1
          && depois <= antes + 1
          && request.resource.data.get("likesBy", {})
            .diff(resource.data.get("likesBy", {}))
            .affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.get("ratingsBy", {})
            .diff(resource.data.get("ratingsBy", {}))
            .affectedKeys().hasOnly([request.auth.uid]);
      }

      // Meta publicada na comunidade é conteúdo público: quem abre o link
      // compartilhado vê o feed antes de criar conta. Interagir (curtir,
      // comentar, avaliar) continua exigindo login.
      allow read: if true;

      // O mural do clube É esta coleção, carimbada com `clubId` (campo NOVO e
      // opcional). Não existe coleção de post de clube: post do clube ganha de
      // graça card, curtida em subcoleção, comentário, denúncia e bloqueio —
      // e aparece no feed geral com o chip `[TAG]`, que é propaganda do clube.
      // Carimbar exige ser MEMBRO; sem isso qualquer um plantava post no mural
      // de qualquer clube.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && clubStampAllowed(request.resource.data.get("clubId", ""), false);

      // Na interação (curtir/avaliar/comentar) o carimbo não é tocado —
      // `affectedKeys` já garante isso —, então quem curte não paga `get` de
      // membro nem precisa ser do clube.
      allow update: if (isGoalOwner()
          && (clubStampUnchanged()
              || clubStampAllowed(request.resource.data.get("clubId", ""), false)))
        || (signedIn() && onlyInteraction());

      allow delete: if isGoalOwner();

      // Quem curtiu: um documento por pessoa, com o uid como id.
      //
      // Antes a curtida era uma chave no mapa `likesBy`, DENTRO do documento do
      // post. Documento no Firestore tem teto de 1 MiB, e comentários dividem o
      // mesmo espaço — medido em 22/08/2026, o post travava em ~16.900 curtidas,
      // e em ~2.800 num post com 2.000 comentários. Ou seja: quanto mais viral,
      // menor o teto. Os marcos de 50k pra cima que o produto quer eram
      // impossíveis, não difíceis.
      //
      // Mesma forma que os participantes de evento: o id ser o uid dá dedup de
      // graça e torna a escrita de terceiro inexistente em vez de limitada.
      match /likes/{likerId} {
        // Post é público; quem curtiu também.
        allow read: if true;

        // `postOwnerId` é conferido contra o dono real do post porque é o campo
        // que soma o total do perfil — sem isso dava pra inflar o número de
        // outra pessoa gravando o uid dela numa curtida qualquer.
        allow create: if signedIn()
          && request.auth.uid == likerId
          && request.resource.data.likerId == likerId
          && request.resource.data.postOwnerId ==
             get(/databases/$(database)/documents/communityGoals/$(goalId)).data.ownerId;

        // Curtida não tem estado pra mudar: ou existe, ou não existe.
        allow update: if false;

        allow delete: if signedIn() && request.auth.uid == likerId;
      }
    }

    // A colecao `events` nao tinha regra nenhuma e caia no deny padrao. Medido
    // em 21/08/2026: 10/10 carregamentos devolviam "Missing or insufficient
    // permissions" e a tela mostrava "Nenhum evento encontrado" — que e mentira,
    // nao e ausencia, e proibicao. A feature de Eventos nunca funcionou em
    // producao para ninguem, nem para quem estava logado.
    match /events/{eventId} {
      // O Engine abre sem login e a agenda e parte do convite: evento e publico.
      allow read: if true;

      // `clubId` é campo NOVO e opcional (CLUBES-MODELO.md §4): evento fora de
      // clube continua como sempre. Com clube, exige CARGO — encontro oficial
      // da crew é do capitão e do fundador, como no Strava. Custa um `get` por
      // criação, e só quando o campo vem preenchido.
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && clubStampAllowed(request.resource.data.get("clubId", ""), true);

      // So o dono edita o evento. Confirmar presenca NAO passa mais por aqui:
      // virou documento proprio na subcolecao abaixo. Antes o RSVP era escrita
      // no documento de outra pessoa, e como o cancelamento reescrevia o array
      // inteiro nenhuma regra conseguia provar QUEM tinha saido — dava pra
      // apagar a presenca alheia. Agora essa escrita simplesmente nao existe.
      //
      // O carimbo de clube é conferido de novo na edição, senão a checagem da
      // criação seria contornável em duas escritas: cria o evento sem clube e
      // depois pendura o `[TAG]` de um clube em que você nem entrou. Quando o
      // carimbo não muda, não custa `get` nenhum.
      allow update: if signedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && (clubStampUnchanged()
            || clubStampAllowed(request.resource.data.get("clubId", ""), true));

      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      // Quem vai ao evento: um documento por pessoa, com o uid como id. A regra
      // fica trivial e forte — voce so escreve no doc que tem o SEU uid.
      //
      // O contador tambem saiu do documento do evento: era desnormalizado,
      // precisava ser escrito por quem confirma (de novo, escrita alheia) e
      // podia sair de sincronia. Agora o numero vem de getCountFromServer.
      //
      // LIMITE CONHECIDO: apagar o evento nao apaga a subcolecao — o Firestore
      // nao faz cascata. Os docs de participante ficam orfaos, invisiveis e
      // inofensivos, mas ficam. Limpar de verdade quer Cloud Function.
      match /participants/{participantId} {
        // A lista de quem vai e publica, como o evento.
        allow read: if true;

        allow create, update: if signedIn()
          && request.auth.uid == participantId
          && request.resource.data.uid == participantId;

        allow delete: if signedIn() && request.auth.uid == participantId;
      }
    }

    // Consulta de GRUPO (collectionGroup) NÃO passa pela regra aninhada dentro de
    // communityGoals: o Firestore avalia um caminho recursivo, não o caminho
    // concreto do documento. Sem este bloco a leitura direta da subcoleção
    // funciona e a consulta de grupo é negada — foi exatamente o que aconteceu
    // em 22/08/2026, e os 35 testes não pegaram porque nenhum fazia consulta de
    // grupo.
    //
    // O feed usa essa consulta uma vez por sessão para saber quais posts a
    // pessoa já curtiu; sem ela, voltaria a perguntar post a post.
    //
    // Só LEITURA. Escrita continua presa ao caminho concreto acima, onde o id
    // do documento tem que ser o uid de quem escreve.
    match /{caminho=**}/likes/{likerId} {
      allow read: if true;
    }

    // CLUBES
    //
    // A feature existia e estava MORTA em produção: `services/clubs.js` só
    // falava com o backend Java (`VITE_API_URL`), e `.env.production` tem a
    // variável vazia — ou seja, no site publicado toda chamada de clube ia
    // para `undefined/api/clubs`. O "tem poucos clubes" nunca foi falta de
    // interesse: era a coleção nunca ter existido. Este bloco é a metade de
    // segurança do port para o Firestore direto.
    //
    // Forma do dado (CLUBES-MODELO.md §7): lista de gente é subcoleção com o
    // uid no id; "meus clubes" é espelho em `users/{uid}/clubs` e NÃO consulta
    // de grupo; `memberCount` é número de vitrine com passo preso em ±1, e o
    // número que aparece em destaque na página do clube vem de agregação.
    match /clubs/{clubId} {
      // A sigla é o que faz o clube parecer crew, e ela é única no app inteiro
      // (registro em `clubTags/{TAG}`, mesmo mecanismo de `usernames/`).
      function nascimentoHonesto() {
        let d = request.resource.data;
        return d.founderId == request.auth.uid
          && d.tag is string
          && d.tag.matches('^[A-Z0-9]{2,5}$')
          && d.memberCount == 1
          && d.archived == false
          // Selo de clube oficial do Engine é editorial: só o admin cria.
          // Sem isto qualquer um nasceria com ★ no card.
          && (d.official == false || isServiceAdmin());
      }

      // Fundador edita tudo, MENOS o que é identidade imutável na fase 1:
      // a sigla (mudar sigla é mudar identidade, e o registro em `clubTags`
      // ficaria apontando para o nada), o próprio `founderId` (transferência
      // de fundação é fase 2) e `official`. `memberCount` também não: ele só
      // anda pelo passo de vitrine abaixo, senão o fundador digitaria 5.000.
      function editaDoFundador() {
        let d = request.resource.data;
        return resource.data.founderId == request.auth.uid
          && d.founderId == resource.data.founderId
          && d.tag == resource.data.tag
          && d.official == resource.data.official
          && d.memberCount == resource.data.memberCount;
      }

      // Capitão cuida do recheio, não da identidade.
      function editaDoCapitao() {
        return isClubStaff(clubId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["description", "rules", "links", "meetupSchedule", "cover", "updatedAt"]);
      }

      // Entrar e sair mexem num contador que mora no documento de OUTRA
      // pessoa — é a mesma classe de escrita alheia do `likesCount`. O passo
      // fica preso em ±1 e, além disso, amarrado ao efeito real do lote:
      // só soma quem ficou membro depois da escrita, e só subtrai quem deixou
      // de ser (ou o capitão que removeu alguém). Sem o `existsAfter` um
      // estranho somava +1 em clube nenhum dele, um por escrita.
      function passoDeVitrine() {
        let antes = resource.data.memberCount;
        let depois = request.resource.data.memberCount;
        let meuDoc = /databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid);
        return signedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["memberCount", "updatedAt"])
          && (
            (depois == antes + 1 && existsAfter(meuDoc))
            || (depois == antes - 1 && (!existsAfter(meuDoc) || isClubStaff(clubId)))
          );
      }

      // O card do clube é público inclusive para clube fechado: descoberta
      // precisa dele. `contentVisibility` esconde a LISTA DE MEMBROS e o link
      // do WhatsApp, não a existência do clube.
      allow read: if true;

      allow create: if signedIn() && nascimentoHonesto();

      allow update: if isServiceAdmin()
        || (signedIn() && editaDoFundador())
        || (signedIn() && editaDoCapitao())
        || passoDeVitrine();

      // Não existe delete: clube arquiva (`archived: true`). Apagar o
      // documento deixaria membros, pedidos e a sigla registrada órfãos —
      // Firestore não faz cascata e o plano Spark não tem Cloud Function.
      allow delete: if false;

      match /members/{memberId} {
        // Fundação: o doc do fundador nasce no MESMO lote do clube, então o
        // clube ainda não existe quando a regra roda. `getAfter` enxerga o
        // estado pós-lote; `get` aqui devolveria null e o create seria negado
        // por acidente.
        function fundacao() {
          return memberId == request.auth.uid
            && request.resource.data.role == "founder"
            && getAfter(/databases/$(database)/documents/clubs/$(clubId)).data.founderId == request.auth.uid;
        }

        function entradaAberta() {
          return memberId == request.auth.uid
            && request.resource.data.role == "member"
            && exists(/databases/$(database)/documents/clubs/$(clubId))
            && get(/databases/$(database)/documents/clubs/$(clubId)).data.joinPolicy == "open";
        }

        // Clube de aprovação: quem cria o doc do membro é o capitão, e só se
        // existir um pedido. É o que impede um capitão de arrastar gente para
        // dentro do clube dele sem que a pessoa tenha pedido.
        function entradaAprovada() {
          return request.resource.data.role == "member"
            && isClubStaff(clubId)
            && exists(/databases/$(database)/documents/clubs/$(clubId)/requests/$(memberId));
        }

        allow read: if get(/databases/$(database)/documents/clubs/$(clubId)).data.contentVisibility == "public"
          || isClubMember(clubId);

        allow create: if signedIn()
          && request.resource.data.uid == memberId
          && (fundacao() || entradaAberta() || entradaAprovada());

        // Duas escritas cabem aqui e mais nenhuma: a pessoa atualizando o
        // próprio nome/avatar desnormalizado (mesmo desenho de `followers`), e
        // o FUNDADOR mudando cargo. Capitão não mexe em cargo — com três
        // papéis, deixar capitão promover capitão é como não ter papel nenhum.
        allow update: if signedIn()
          && request.resource.data.uid == memberId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["role", "displayName", "username", "avatar", "title"])
          && (
            (request.resource.data.role == resource.data.role && memberId == request.auth.uid)
            || (
              isClubFounder(clubId)
              && resource.data.role != "founder"
              && request.resource.data.role in ["captain", "member"]
            )
          );

        // Fundador NÃO sai (regra do Strava: o dono passa o bastão antes).
        // Sem isso o clube fica sem ninguém que possa editar a identidade.
        allow delete: if signedIn() && (
          (memberId == request.auth.uid && resource.data.role != "founder")
          || (isClubStaff(clubId) && resource.data.role == "member")
          || (isClubFounder(clubId) && resource.data.role != "founder")
        );
      }

      match /requests/{requesterId} {
        // O pedido é entre quem pediu e a direção do clube. Ninguém mais lê
        // quem tentou entrar e não foi aceito.
        allow read: if signedIn() && (requesterId == request.auth.uid || isClubStaff(clubId));

        allow create: if signedIn()
          && requesterId == request.auth.uid
          && request.resource.data.uid == requesterId
          && get(/databases/$(database)/documents/clubs/$(clubId)).data.joinPolicy == "approval";

        // Pedido não muda de ideia: ou some (recusado/aprovado), ou fica.
        allow update: if false;

        allow delete: if signedIn() && (requesterId == request.auth.uid || isClubStaff(clubId));
      }
    }

    // Unicidade da sigla. Vem do registro, não de uma consulta: consulta lê um
    // instante e duas criações simultâneas passariam as duas. Aqui o segundo
    // lote bate num documento que já existe, e `update: if false` o derruba.
    //
    // O `getAfter` amarra o registro ao clube do MESMO lote: não dá para
    // reservar uma sigla apontando para clube alheio, nem registrar `ABC`
    // apontando para um clube cuja sigla é outra.
    match /clubTags/{tag} {
      allow read: if signedIn();
      // `existsAfter` na frente porque `getAfter` de documento que não existe
      // devolve null, e ler `.founderId` de null é ERRO de avaliação. O
      // Firestore nega em cima do erro, então o efeito parecia certo — mas
      // registrar sigla apontando para um clube inexistente tem que ser
      // negado de propósito, não por acidente.
      allow create: if signedIn()
        && request.resource.data.clubId is string
        && existsAfter(/databases/$(database)/documents/clubs/$(request.resource.data.clubId))
        && getAfter(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.founderId == request.auth.uid
        && getAfter(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.tag == tag;
      allow update: if false;
      allow delete: if isServiceAdmin();
    }

    // Espelho de "meus clubes". Existe para NÃO haver `collectionGroup` em
    // members: consulta de grupo não passa pela regra aninhada, pediria um
    // match recursivo de leitura e um índice COLLECTION_GROUP — exatamente a
    // porta que o override de `members.userId` deixava aberta, e que saiu do
    // `firestore.indexes.json` junto com este bloco.
    //
    // O dono escreve o próprio espelho. A exceção é a aprovação de pedido: o
    // capitão cria o doc de membro, e sem esta segunda via o aprovado não veria
    // o clube em "meus clubes" até tropeçar nele. Ela só vale se a pessoa
    // realmente virou membro no mesmo lote (`existsAfter`), então não dá para
    // pendurar clube na lista de quem nunca entrou.
    match /users/{userId}/clubs/{clubId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        || (isClubStaff(clubId)
            && existsAfter(/databases/$(database)/documents/clubs/$(clubId)/members/$(userId)));
      allow delete: if isOwner(userId)
        || (isClubStaff(clubId)
            && !existsAfter(/databases/$(database)/documents/clubs/$(clubId)/members/$(userId)));
    }

    // Vitrine editorial ("clube da semana"). Escolha do Murilo na mão, que é o
    // que ele faria de qualquer jeito nos primeiros meses; automático precisa
    // de volume que ainda não existe.
    match /featured/{docId} {
      allow read: if true;
      allow write: if isServiceAdmin();
    }

    // Denúncias: qualquer pessoa logada abre uma, ninguém além da moderação lê
    // ou mexe depois — inclusive quem denunciou não relê a própria denúncia.
    match /reports/{reportId} {
      allow read, update, delete: if isServiceAdmin();
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.reason is string;
    }

    // Mensagens diretas: só quem está na conversa lê ou escreve.
    match /conversations/{conversationId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.memberIds;
      }

      function memberIdsOf(id) {
        return get(/databases/$(database)/documents/conversations/$(id)).data.memberIds;
      }

      // `get` num doc inexistente traz resource == null: sem esse caso, ler
      // uma conversa que ainda vai ser criada é negado e ninguém consegue
      // abrir o primeiro papo. Em list, todo doc devolvido existe.
      allow get: if resource == null || isMember();
      allow list: if isMember();
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == 2;
      // A lista de participantes é imutável — ninguém entra numa conversa alheia.
      allow update: if isMember()
        && request.resource.data.memberIds == resource.data.memberIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in memberIdsOf(conversationId);
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in memberIdsOf(conversationId);
        allow update, delete: if signedIn()
          && resource.data.senderId == request.auth.uid;
      }
    }

    match /serviceListings/{listingId} {
      // Anúncio aprovado é público de propósito: o prestador divulga o link do
      // Engine na bio dele, e quem chega por ali ainda não tem conta. Exigir
      // login aqui entregava tela vazia justamente pra quem ele trouxe.
      // Rascunho e reprovado continuam restritos ao dono e à moderação.
      allow read: if resource.data.moderationStatus == "approved"
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isServiceAdmin();

      // Métricas do anúncio: quem visita incrementa o contador no documento de
      // outra pessoa, então update não pode ser só do dono. A trava é dupla —
      // só estes três campos, e cada um só pode ficar igual ou subir de um em
      // um, nunca cair nem pular. Não dá pra zerar a métrica alheia nem
      // mascarar edição de conteúdo como se fosse visita.
      function onlyMetricIncrement() {
        let counters = ["viewCount", "detailCount", "whatsappCount"];
        let before = resource.data;
        let after = request.resource.data;
        return after.diff(before).affectedKeys().hasOnly(counters)
          && after.get("viewCount", 0) >= before.get("viewCount", 0)
          && after.get("viewCount", 0) <= before.get("viewCount", 0) + 1
          && after.get("detailCount", 0) >= before.get("detailCount", 0)
          && after.get("detailCount", 0) <= before.get("detailCount", 0) + 1
          && after.get("whatsappCount", 0) >= before.get("whatsappCount", 0)
          && after.get("whatsappCount", 0) <= before.get("whatsappCount", 0) + 1;
      }
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.moderationStatus == "pending";
      allow update: if isServiceAdmin()
        || onlyMetricIncrement()
        || (
          signedIn()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.moderationStatus == "pending"
        );
      allow delete: if isServiceAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);
    }
  }
}
